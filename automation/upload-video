#!/bin/zsh
set -e

REMOTE_HOST="rtime"
REMOTE_BASE="/var/www/scheduling-seminar/html/videos"

REPO="${0:A:h:h}"

# With no URL, use the latest talk that has a YouTube video but no uploaded file yet
if [[ -z "$1" ]]; then
    git -C "$REPO" pull --ff-only
    YT_URL=$(node "$REPO/scripts/pending-video.js")
    echo "Using $YT_URL"
else
    YT_URL="$1"
fi

# --- Fetch metadata ---
echo "Fetching metadata..."
YT_DATE=$(yt-dlp --no-download --print "%(release_date)s" "$YT_URL")
YT_TITLE=$(yt-dlp --no-download --print "%(title)s" "$YT_URL")
YT_ID=$(yt-dlp --no-download --print "%(id)s" "$YT_URL")

# YYYYMMDD → YY_MM_DD
FORMATTED_DATE="${YT_DATE[3,4]}_${YT_DATE[5,6]}_${YT_DATE[7,8]}"

# Parse "Speaker (Affiliation) Talk title"
SPEAKER=$(echo "$YT_TITLE" | grep -oE '^(.+\([^)]+\))+')
TALK=$(echo "$YT_TITLE" | sed -E 's/^(.+\([^)]+\))[[:space:]]*//; s/^[|:–-]+[[:space:]]*//' | tr '/|' '--')

if [[ -z "$SPEAKER" ]]; then
    NEW_NAME="${FORMATTED_DATE}_${TALK}.mp4"
else
    NEW_NAME="${FORMATTED_DATE}_${SPEAKER}_${TALK}.mp4"
fi

echo "Filename: $NEW_NAME"
echo ""

# --- Download ---
DEST=~/Downloads/"$NEW_NAME"
if [[ ! -f "$DEST" ]]; then
    yt-dlp -f "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]" \
           --merge-output-format mp4 \
           -o "$DEST" \
           "$YT_URL"
fi

echo "Existing folders:"
ssh "$REMOTE_HOST" "ls -1 '$REMOTE_BASE'"
echo ""

# Folders are named YY_<1|2|3>_<Winter|Spring|Fall>
MONTH=$((10#${FORMATTED_DATE[4,5]}))
if (( MONTH <= 3 )); then SEASON="1_Winter"; elif (( MONTH <= 8 )); then SEASON="2_Spring"; else SEASON="3_Fall"; fi
DEFAULT_FOLDER="${FORMATTED_DATE[1,2]}_${SEASON}"
echo "Enter folder name (default: $DEFAULT_FOLDER; created if it doesn't exist):"
read FOLDER

[[ -z "$FOLDER" ]] && FOLDER="$DEFAULT_FOLDER"
ssh "$REMOTE_HOST" "mkdir -p '$REMOTE_BASE/$FOLDER'"
echo "Copying $NEW_NAME to $REMOTE_HOST:$REMOTE_BASE/$FOLDER/"
scp "$DEST" "$REMOTE_HOST:$REMOTE_BASE/$FOLDER/"
rm "$DEST"

echo "Done."
echo ""
VIDEO_URL="https://scheduling-seminar.iid.ciirc.cvut.cz/videos/$FOLDER/$NEW_NAME"
echo "$VIDEO_URL"

# --- Link the video to the talk and mark it past ---
REPO="${0:A:h:h}"
TALK_DATE="20${FORMATTED_DATE[1,2]}-${FORMATTED_DATE[4,5]}-${FORMATTED_DATE[7,8]}"
if node "$REPO/scripts/attach-video.js" "$TALK_DATE" "$VIDEO_URL" "$YT_ID"; then
    echo -n "Commit and push the talk update? [y/N] "
    read CONFIRM
    if [[ "$CONFIRM" == [yY] ]]; then
        git -C "$REPO" add src/content/talks
        git -C "$REPO" commit -m "Add video for talk on $TALK_DATE"
        git -C "$REPO" push
    fi
fi